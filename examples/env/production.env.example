COMPOSE_PROJECT_NAME=infrastructure
COMPOSE_PROFILES=proxy,postgres,redis,rabbitmq,monitoring
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.4-alpine
POSTGRES_IMAGE=postgres:18.3-alpine
REDIS_IMAGE=redis:8.8.1-alpine
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
LOKI_IMAGE=grafana/loki:3.7.4
ALLOY_IMAGE=grafana/alloy:v1.18.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.88.0
NGINX_RUNTIME_IMAGE=ghcr.io/example/infrastructure-nginx:v1.0.0
POSTGRES_RUNTIME_IMAGE=ghcr.io/example/infrastructure-postgres:v1.0.0
REDIS_RUNTIME_IMAGE=ghcr.io/example/infrastructure-redis:v1.0.0
RABBITMQ_RUNTIME_IMAGE=ghcr.io/example/infrastructure-rabbitmq:v1.0.0
SECRETS_PATH=/etc/infrastructure/secrets
HTTP_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
POSTGRES_DB=infrastructure
POSTGRES_USER=infrastructure
REDIS_USER=infrastructure
RABBITMQ_DEFAULT_USER=infrastructure
BACKUP_PATH=/var/backups/infrastructure
BACKUP_RETENTION_DAYS=30
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
GRAFANA_ROOT_URL=https://infrastructure.example.com/grafana/
