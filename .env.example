# Copy to .env and adjust locally. Never commit .env or real secret files.

# Make appends ENV to this prefix, for example infrastructure-local.
COMPOSE_PROJECT_NAME=infrastructure

# Comma-separated optional service profiles. An empty value selects only
# services without a profile. Available profiles are introduced with services.
COMPOSE_PROFILES=

# Versioned infrastructure images. For production, replace tags with OCI
# digests (image@sha256:...).
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.4-alpine
POSTGRES_IMAGE=postgres:18.3-alpine
REDIS_IMAGE=redis:8.8.1-alpine
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
GRAFANA_IMAGE=grafana/grafana:13.1.0
LOKI_IMAGE=grafana/loki:3.7.4
ALLOY_IMAGE=grafana/alloy:v1.18.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.88.0

# Published custom images. Local defaults are built by Compose. Deployment may
# override these with ghcr.io/<owner>/<name>:<version> or immutable digests.
NGINX_RUNTIME_IMAGE=infrastructure-nginx:local
POSTGRES_RUNTIME_IMAGE=infrastructure-postgres:local
REDIS_RUNTIME_IMAGE=infrastructure-redis:local
RABBITMQ_RUNTIME_IMAGE=infrastructure-rabbitmq:local

# Host ports used by infrastructure endpoints in environments that publish them.
HTTP_PORT=8080
HTTPS_PORT=8443
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Non-secret service identifiers. Credentials are supplied through files under
# secrets/ or by the deployment platform and are never stored in this file.
POSTGRES_DB=infrastructure
POSTGRES_USER=infrastructure
RABBITMQ_DEFAULT_USER=infrastructure
REDIS_USER=infrastructure
SECRETS_PATH=./secrets

# Local host directory used by future backup tooling.
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14

# Monitoring retention and public URL used by Grafana behind the proxy.
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=336h
GRAFANA_ROOT_URL=http://localhost:8080/grafana/
